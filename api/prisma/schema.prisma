// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Category {
  STARTER
  MAIN_COURSE
  DESSERT
}

enum PlanType {
  PERSONAL
  SHARED
}

enum PlanRole {
  MEMBER
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REJECTED
}

model User {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  password  String
  isEmailVerified     Boolean   @default(false)
  emailVerifyToken    String?   @unique
  resetPasswordToken  String?   @unique
  resetPasswordExpires DateTime?
  createdAt DateTime @default(now())

  memberships         PlanMember[]
  sentInvitations     PlanInvitation[] @relation("InvitedBy")
  receivedInvitations PlanInvitation[] @relation("Invitee")
  comments            Comment[]
  ratings             Rating[]
  plan                Plan[]             @relation("planOwner")

  @@map("users")
}

model Plan {
  id        Int      @id @default(autoincrement())
  ownerId   Int 
  owner     User     @relation("planOwner",fields: [ownerId], references: [id], onDelete: Cascade)
  name      String
  type      PlanType @default(PERSONAL)
  createdAt DateTime @default(now())

  members     PlanMember[]
  invitations PlanInvitation[]
  meals       Meal[]

  @@map("plans")
}

model PlanMember {
  id       Int      @id @default(autoincrement())
  userId   Int
  planId   Int
  role     PlanRole @default(MEMBER)
  joinedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan Plan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@unique([userId, planId])
  @@map("plan_members")
}

model PlanInvitation {
  id          Int              @id @default(autoincrement())
  planId      Int
  invitedById Int
  inviteeId   Int
  status      InvitationStatus @default(PENDING)
  respondedAt DateTime?
  createdAt   DateTime         @default(now())

  plan      Plan @relation(fields: [planId], references: [id], onDelete: Cascade)
  invitedBy User @relation("InvitedBy", fields: [invitedById], references: [id], onDelete: Cascade)
  invitee   User @relation("Invitee", fields: [inviteeId], references: [id], onDelete: Cascade)

  @@unique([planId, inviteeId])
  @@index([inviteeId, status])
  @@map("plan_invitations")
}

model Meal {
  id          Int      @id @default(autoincrement())
  name        String
  description String?
  category    Category
  image       String?

  planId Int
  plan   Plan @relation(fields: [planId], references: [id], onDelete: Cascade)

  ingredients MealIngredient[]
  schedules   MealSchedule[]
  comments    Comment[]
  ratings     Rating[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([planId])
  @@map("meals")
}

model Ingredient {
  id   Int    @id @default(autoincrement())
  name String @unique @db.VarChar(100)

  meals MealIngredient[]

  createdAt DateTime @default(now())

  @@map("ingredients")
}

model MealIngredient {
  mealId       Int
  ingredientId Int

  quantity Decimal? @db.Decimal(10, 2)
  unit     String?  @db.VarChar(30)

  meal       Meal       @relation(fields: [mealId], references: [id], onDelete: Cascade)
  ingredient Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)

  @@id([mealId, ingredientId])
  @@map("meal_ingredients")
}

model MealSchedule {
  id            Int      @id @default(autoincrement())
  mealId        Int
  scheduledDate DateTime @db.Date

  meal Meal @relation(fields: [mealId], references: [id], onDelete: Cascade)

  @@index([scheduledDate])
  @@index([mealId])
  @@map("meal_schedules")
}

model Comment {
  id     Int    @id @default(autoincrement())
  mealId Int
  userId Int
  text   String @db.Text

  meal Meal @relation(fields: [mealId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([mealId])
  @@map("comments")
}

model Rating {
  id     Int @id @default(autoincrement())
  mealId Int
  userId Int
  score  Int

  meal Meal @relation(fields: [mealId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([mealId])
  @@map("ratings")
}